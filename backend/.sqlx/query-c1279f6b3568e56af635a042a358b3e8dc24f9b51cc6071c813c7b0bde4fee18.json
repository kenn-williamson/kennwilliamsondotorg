{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT\n                        id, slug, title, excerpt, content, featured_image_url, featured_image_alt,\n                        status, tags as \"tags!\", published_at, created_at, updated_at, meta_description\n                    FROM blog_posts\n                    WHERE status = $1 AND $2 = ANY(tags)\n                    ORDER BY created_at DESC\n                    LIMIT $3 OFFSET $4\n                    ",
